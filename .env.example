# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the two values.
# Both are read on the server only — they are never sent to the browser.
# See the README section "Connecting the Google Sheet" for how to get them.
# ---------------------------------------------------------------------------

# The Apps Script Web App URL. It must end with /exec (not /dev).
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXXXXX/exec

# Any long random string. Must match SHARED_TOKEN at the top of apps-script/Code.gs exactly.
SHEETS_WEBHOOK_TOKEN=
